# Copy to .env and adjust as needed

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# For local development (host PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_ticketing?schema=public

# For Docker containerized PostgreSQL (default in docker-compose.yml)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/event_ticketing?schema=public

# Redis URL (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# App
PORT=3000
NODE_ENV=development