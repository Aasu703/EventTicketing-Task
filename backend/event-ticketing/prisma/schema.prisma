generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model events {
  id         Int       @id @default(autoincrement())
  event_name String    @db.VarChar(100)
  event_date DateTime? @db.Timestamp(6)
}

model User{
  id         Int      @id @default(autoincrement())
  userName  String?
  email      String   @unique 
  phoneNumber BigInt 
  password   String
  createdAt  DateTime @default(now())
}